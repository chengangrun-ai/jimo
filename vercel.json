{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": ".next",
  "git": {
    "ignoredBuildStep": ""
  },
  "functions": {
    "app/render/**": {
      "maxDuration": 60
    },
    "app/api/bundle/**": {
      "maxDuration": 60
    }
  }
}
